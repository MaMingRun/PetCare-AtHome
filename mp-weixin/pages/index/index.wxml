<view class="page">
  <!-- 品牌区 -->
  <view class="hero">
    <view class="hero-title">宠物到家</view>
    <view class="hero-sub">专业宠托师上门服务 · 全程留痕可追溯</view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view scroll-x class="cats" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat {{activeCategory === item ? 'cat-active' : ''}}"
      data-c="{{item}}"
      bindtap="switchCategory"
    >{{item}}</view>
  </scroll-view>

  <!-- 服务卡片 -->
  <view wx:if="{{services.length === 0 && !loading}}" class="empty">暂无服务</view>
  <view
    wx:for="{{services}}"
    wx:key="id"
    class="card svc"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="svc-cover">{{item.firstChar}}</view>
    <view class="col" style="flex:1">
      <view class="row between">
        <view class="title">{{item.name}}</view>
        <view class="price">{{item.priceYuan}}</view>
      </view>
      <view class="muted" style="margin:8rpx 0">{{item.category}} · {{item.durationMinutes}}分钟/次</view>
      <view>
        <text wx:for="{{item.tagList}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>
  </view>
</view>

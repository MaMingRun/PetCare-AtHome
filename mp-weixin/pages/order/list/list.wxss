.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 24rpx;
  margin: 0 -24rpx 20rpx;
}
.tab {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  color: var(--text-sub);
  font-size: 26rpx;
}
.tab-active { background: var(--brand-light); color: var(--brand); font-weight: 600; }

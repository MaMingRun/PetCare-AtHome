.addr {
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.addr-active { border-color: var(--brand); background: var(--brand-light); }

.pet {
  padding: 16rpx 28rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}
.pet-active { border-color: var(--brand); background: var(--brand-light); color: var(--brand); }

.slot {
  padding: 14rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}
.slot-active { border-color: var(--brand); background: var(--brand-light); color: var(--brand); }

.stepper {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: #f2f3f5;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
}
.picker-value { color: var(--brand); }

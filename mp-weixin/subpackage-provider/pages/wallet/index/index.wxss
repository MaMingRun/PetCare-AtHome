.wallet-card {
  background: linear-gradient(135deg, var(--brand), #ffb37e);
  border-radius: 20rpx;
  padding: 44rpx 32rpx;
  color: #fff;
  margin-bottom: 32rpx;
}
.wallet-balance { font-size: 64rpx; font-weight: 700; margin-top: 12rpx; }
.withdraw-btn {
  background: rgba(255, 255, 255, .25);
  color: #fff;
  padding: 14rpx 44rpx;
  font-size: 28rpx;
  align-self: center;
}

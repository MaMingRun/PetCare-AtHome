<view class="page">
  <view wx:if="{{error}}" class="empty">{{error}}</view>

  <block wx:if="{{credential}}">
    <view class="card" style="text-align:center;padding:60rpx 28rpx">
      <view class="tag tag-blue" style="margin-bottom:24rpx">{{credential.entryModeText}}</view>
      <view wx:if="{{credential.secret}}" class="secret">{{credential.secret}}</view>
      <view class="muted" style="margin-top:24rpx">{{credential.tip}}</view>
    </view>

    <view class="card muted" style="line-height:1.8">
      凭证仅在本单服务窗口内可见；每次查看和使用都会写入日志，用户端透明可查。
    </view>

    <view class="row" wx:if="{{credential.secret}}" style="margin-top:20rpx">
      <view class="btn btn-grey" style="flex:1;margin-right:20rpx" bindtap="copySecret">复制凭证</view>
      <view class="btn btn-primary" style="flex:1" bindtap="unlock">使用凭证开锁</view>
    </view>
  </block>
</view>
